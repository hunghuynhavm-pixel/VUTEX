# === Sao chép file này thành .env và điền thông tin thật ===
# LƯU Ý: file .env KHÔNG được commit lên GitHub (đã có trong .gitignore)

# Token truy cập GHL API (Private Integration Token hoặc OAuth Access Token)
GHL_TOKEN=

# ID của sub-account (Location) trong GHL
GHL_LOCATION_ID=

# --- Dành cho đăng BLOG ---
# ID của blog (lấy bằng: python post.py --list)
GHL_BLOG_ID=
# ID tác giả mặc định
GHL_AUTHOR_ID=

# Phiên bản API GHL (thường không cần đổi)
GHL_API_VERSION=2021-07-28
